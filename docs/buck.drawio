        <!-- ===== State equations table (single HTML cell = not individually selectable) ===== -->
        <mxCell id="eq_table" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:14px;padding-bottom:6px;&quot;&gt;State-Space Equations (Continuous-Time, Averaged)&lt;/div&gt;&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;8&quot; style=&quot;border-collapse:collapse;font-family:Arial;font-size:13px;width:100%;&quot;&gt;&lt;tr style=&quot;background:#dddddd;font-weight:bold;&quot;&gt;&lt;th style=&quot;border:1px solid #000;padding:6px;&quot;&gt;State&lt;/th&gt;&lt;th style=&quot;border:1px solid #000;padding:6px;&quot;&gt;Derived From (Loop / Node)&lt;/th&gt;&lt;th style=&quot;border:1px solid #000;padding:6px;&quot;&gt;Equation&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;&quot;&gt;i&lt;sub&gt;L&lt;/sub&gt; &amp;nbsp;(inductor current)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;&quot;&gt;KVL loop: Vin → Q1/Q2 → L → v&lt;sub&gt;C&lt;/sub&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;font-family:Cambria Math,serif;&quot;&gt;L · di&lt;sub&gt;L&lt;/sub&gt;/dt = d · V&lt;sub&gt;in&lt;/sub&gt; − v&lt;sub&gt;C&lt;/sub&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;&quot;&gt;v&lt;sub&gt;C&lt;/sub&gt; &amp;nbsp;(output cap voltage)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;&quot;&gt;KCL at Vout node: i&lt;sub&gt;L&lt;/sub&gt; = i&lt;sub&gt;C&lt;/sub&gt; + i&lt;sub&gt;R&lt;/sub&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;font-family:Cambria Math,serif;&quot;&gt;C · dv&lt;sub&gt;C&lt;/sub&gt;/dt = i&lt;sub&gt;L&lt;/sub&gt; − v&lt;sub&gt;C&lt;/sub&gt; / R&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f5f5f5;&quot;&gt;&lt;td colspan=&quot;3&quot; style=&quot;border:1px solid #000;padding:6px;font-size:11px;font-style:italic;&quot;&gt;where d = duty cycle of Q1 (0 ≤ d ≤ 1), Q2 switches complementary with dead-time. Averaged model valid for f &lt;&lt; f&lt;sub&gt;sw&lt;/sub&gt;.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;overflow=hidden;" vertex="1" parent="1">
