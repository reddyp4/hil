  <diagram name="discrete" id="discrete_tab">
    <mxGraphModel dx="1768" dy="1051" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="d0" />
        <mxCell id="d1" parent="d0" />
        <mxCell id="disc_title" parent="d1" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" value="Discrete-Time State Equations" vertex="1">
          <mxGeometry height="34" width="500" x="200" y="24" as="geometry" />
        </mxCell>
        <mxCell id="disc_subtitle" parent="d1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#555555;" value="Synchronous Buck — Forward Euler, switched model (uses PWM q[k], not averaged duty d)" vertex="1">
          <mxGeometry height="22" width="700" x="100" y="58" as="geometry" />
        </mxCell>
        <mxCell id="disc_eq_table" parent="d1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;overflow=hidden;" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:15px;padding-bottom:4px;&quot;&gt;Discrete-Time State Update (Forward Euler)&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:11px;font-style:italic;padding-bottom:10px;color:#555;&quot;&gt;dx/dt ≈ (x[k+1] − x[k]) / Δt&lt;/div&gt;&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;10&quot; style=&quot;border-collapse:collapse;font-family:Arial;font-size:14px;width:100%;&quot;&gt;&lt;tr style=&quot;background:#dddddd;font-weight:bold;&quot;&gt;&lt;th style=&quot;border:1px solid #000;padding:8px;width:22%;&quot;&gt;State&lt;/th&gt;&lt;th style=&quot;border:1px solid #000;padding:8px;&quot;&gt;Update Equation&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:10px;text-align:center;font-weight:bold;&quot;&gt;i&lt;sub&gt;L&lt;/sub&gt;[k+1]&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:10px;font-family:Cambria Math,serif;&quot;&gt;= i&lt;sub&gt;L&lt;/sub&gt;[k] + (Δt / L) · ( q[k] · V&lt;sub&gt;in&lt;/sub&gt;[k] − v&lt;sub&gt;C&lt;/sub&gt;[k] − i&lt;sub&gt;L&lt;/sub&gt;[k] · R&lt;sub&gt;L&lt;/sub&gt; )&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:10px;text-align:center;font-weight:bold;&quot;&gt;v&lt;sub&gt;C&lt;/sub&gt;[k+1]&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:10px;font-family:Cambria Math,serif;&quot;&gt;= v&lt;sub&gt;C&lt;/sub&gt;[k] + (Δt / C) · ( i&lt;sub&gt;L&lt;/sub&gt;[k] − v&lt;sub&gt;C&lt;/sub&gt;[k] / R&lt;sub&gt;load&lt;/sub&gt; )&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="230" width="780" x="60" y="100" as="geometry" />
        </mxCell>
        <mxCell id="disc_fpga" parent="d1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;overflow=hidden;" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:15px;padding-bottom:4px;&quot;&gt;FPGA-Friendly Form (divisions eliminated, constants precomputed)&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:11px;font-style:italic;padding-bottom:10px;color:#555;&quot;&gt;Pre-compute c&lt;sub&gt;1&lt;/sub&gt;..c&lt;sub&gt;5&lt;/sub&gt; at compile time → runtime path is multiply-and-add only (no dividers synthesized)&lt;/div&gt;&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;10&quot; style=&quot;border-collapse:collapse;font-family:Arial;font-size:14px;width:100%;&quot;&gt;&lt;tr style=&quot;background:#dddddd;font-weight:bold;&quot;&gt;&lt;th style=&quot;border:1px solid #000;padding:8px;width:22%;&quot;&gt;State&lt;/th&gt;&lt;th style=&quot;border:1px solid #000;padding:8px;&quot;&gt;FPGA-Friendly Update Equation&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:10px;text-align:center;font-weight:bold;&quot;&gt;i&lt;sub&gt;L&lt;/sub&gt;[k+1]&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:10px;font-family:Cambria Math,serif;&quot;&gt;= i&lt;sub&gt;L&lt;/sub&gt;[k] + c&lt;sub&gt;1&lt;/sub&gt; · ( q[k] · V&lt;sub&gt;in&lt;/sub&gt;[k] ) − c&lt;sub&gt;2&lt;/sub&gt; · v&lt;sub&gt;C&lt;/sub&gt;[k] − c&lt;sub&gt;3&lt;/sub&gt; · i&lt;sub&gt;L&lt;/sub&gt;[k]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:10px;text-align:center;font-weight:bold;&quot;&gt;v&lt;sub&gt;C&lt;/sub&gt;[k+1]&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:10px;font-family:Cambria Math,serif;&quot;&gt;= v&lt;sub&gt;C&lt;/sub&gt;[k] + c&lt;sub&gt;4&lt;/sub&gt; · i&lt;sub&gt;L&lt;/sub&gt;[k] − c&lt;sub&gt;5&lt;/sub&gt; · v&lt;sub&gt;C&lt;/sub&gt;[k]&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;height:10px;&quot;&gt;&lt;/div&gt;&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;8&quot; style=&quot;border-collapse:collapse;font-family:Arial;font-size:13px;width:100%;&quot;&gt;&lt;tr style=&quot;background:#e8e8e8;font-weight:bold;&quot;&gt;&lt;th style=&quot;border:1px solid #000;padding:6px;width:14%;&quot;&gt;Constant&lt;/th&gt;&lt;th style=&quot;border:1px solid #000;padding:6px;width:28%;&quot;&gt;Definition&lt;/th&gt;&lt;th style=&quot;border:1px solid #000;padding:6px;&quot;&gt;Numerical value @ Δt=100ns, L=100µH, C=100µF, R&lt;sub&gt;L&lt;/sub&gt;=50mΩ, R&lt;sub&gt;load&lt;/sub&gt;=6Ω&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;text-align:center;font-weight:bold;&quot;&gt;c&lt;sub&gt;1&lt;/sub&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;&quot;&gt;Δt / L&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;&quot;&gt;1.0 × 10&lt;sup&gt;−3&lt;/sup&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;text-align:center;font-weight:bold;&quot;&gt;c&lt;sub&gt;2&lt;/sub&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;&quot;&gt;Δt / L&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;&quot;&gt;1.0 × 10&lt;sup&gt;−3&lt;/sup&gt; &amp;nbsp;(= c&lt;sub&gt;1&lt;/sub&gt;)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;text-align:center;font-weight:bold;&quot;&gt;c&lt;sub&gt;3&lt;/sub&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;&quot;&gt;Δt · R&lt;sub&gt;L&lt;/sub&gt; / L&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;&quot;&gt;5.0 × 10&lt;sup&gt;−5&lt;/sup&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;text-align:center;font-weight:bold;&quot;&gt;c&lt;sub&gt;4&lt;/sub&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;&quot;&gt;Δt / C&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;&quot;&gt;1.0 × 10&lt;sup&gt;−3&lt;/sup&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;text-align:center;font-weight:bold;&quot;&gt;c&lt;sub&gt;5&lt;/sub&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;&quot;&gt;Δt / (C · R&lt;sub&gt;load&lt;/sub&gt;)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;&quot;&gt;1.667 × 10&lt;sup&gt;−4&lt;/sup&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="414" width="780" x="60" y="360" as="geometry" />
        </mxCell>
        <mxCell id="disc_notes" parent="d1" style="text;html=1;strokeColor=#B5B5B5;fillColor=#F8F8F8;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;overflow=hidden;" value="&lt;div style=&quot;font-family:Arial;font-size:12px;line-height:1.6;padding:4px;&quot;&gt;&lt;b&gt;Symbol legend:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;q[k] ∈ {0, 1} — switching function (1 ⇒ Q1 ON, 0 ⇒ Q2 ON, complementary with dead-time)&lt;br&gt;&amp;nbsp;&amp;nbsp;Δt — simulation step size&lt;br&gt;&amp;nbsp;&amp;nbsp;R&lt;sub&gt;L&lt;/sub&gt; — inductor series resistance (DCR)&lt;br&gt;&amp;nbsp;&amp;nbsp;R&lt;sub&gt;load&lt;/sub&gt; — output load resistance&lt;br&gt;&amp;nbsp;&amp;nbsp;V&lt;sub&gt;in&lt;/sub&gt;[k] — input source voltage (allowed to vary during sim)&lt;br&gt;&lt;br&gt;&lt;b&gt;Notes:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• Forward Euler is explicit — maps directly to a Verilog MAC per state per Δt tick.&lt;br&gt;&amp;nbsp;&amp;nbsp;• q[k] is the instantaneous PWM state (switched, not averaged duty d), so Δt must resolve PWM edges — rule of thumb: Δt ≤ 1/(20·f&lt;sub&gt;sw&lt;/sub&gt;).&lt;br&gt;&amp;nbsp;&amp;nbsp;• Stability: need Δt &amp;lt; 2L/R&lt;sub&gt;L&lt;/sub&gt; (RL loop) and Δt &amp;lt;&amp;lt; 2π√(LC) (LC resonance).&lt;br&gt;&amp;nbsp;&amp;nbsp;• Sanity check (steady state): setting i&lt;sub&gt;L&lt;/sub&gt;[k+1]=i&lt;sub&gt;L&lt;/sub&gt;[k] and v&lt;sub&gt;C&lt;/sub&gt;[k+1]=v&lt;sub&gt;C&lt;/sub&gt;[k] gives V&lt;sub&gt;out&lt;/sub&gt; = d·V&lt;sub&gt;in&lt;/sub&gt; / (1 + R&lt;sub&gt;L&lt;/sub&gt;/R&lt;sub&gt;load&lt;/sub&gt;) — reduces to ideal d·V&lt;sub&gt;in&lt;/sub&gt; when R&lt;sub&gt;L&lt;/sub&gt;=0. ✓&lt;br&gt;&amp;nbsp;&amp;nbsp;• Example: V&lt;sub&gt;in&lt;/sub&gt;=24V, L=100µH, C=100µF, R&lt;sub&gt;load&lt;/sub&gt;=6Ω, f&lt;sub&gt;sw&lt;/sub&gt;=100kHz → Δt ≈ 100ns is safe.&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="780" x="60" y="774" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
